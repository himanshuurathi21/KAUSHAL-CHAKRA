# Copy to .env and adjust for your machine
# Local Postgres (default):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kaushalchakra?schema=public"
# Neon (hosted Postgres) — recommended for demos and Render free tier:
DATABASE_URL="postgresql://neondb_owner:npg_xxx@ep-xxx-pooler.c-3.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=4000

# Optional: require users to wait N days after signup before using credit
# teaching (Phase 3). 0 = allowed immediately.
# CREDIT_MIN_WAIT_DAYS=0

# Optional: re-run matching automatically every N ms so the waiting pool
# clears without anyone clicking "Run matching now". Off when unset.
# AUTO_MATCH_INTERVAL_MS=600000

# Fairness: the engine shuffles users before each DB run so equal-quality
# tie cycles rotate winners instead of favouring low user ids.
# Set to 0 for a fully deterministic viva demo.
# MATCH_SHUFFLE=1
