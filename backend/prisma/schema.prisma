// KaushalChakra - Prisma schema
// PostgreSQL database with the following models:
// User, Skill, UserOfferedSkill, UserWantedSkill,
// MatchCycle, MatchCycleParticipant, BlockedEdge (internal, tracks rejected edges),
// Rating, Message, Notification, Credit, CreditSession,
// SkillVerification (quiz + certificate proof of claimed levels)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VerificationStatus {
  NONE
  QUIZ_PASSED
  CERT_SUBMITTED
  CERT_VERIFIED
}

enum ReportStatus {
  PENDING
  WARNED
  REMOVED
  CREDIT_HOLD
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  EXPERT
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  department   String?
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())
  consentGivenAt DateTime?
  availabilitySlots String[] @default([])
  creditsFrozen Boolean @default(false)
  isActive      Boolean @default(true)

  offered          UserOfferedSkill[]
  wanted           UserWantedSkill[]
  participants     MatchCycleParticipant[]
  blockedEdgesFrom BlockedEdge[]          @relation("BlockedFrom")
  blockedEdgesTo   BlockedEdge[]          @relation("BlockedTo")
  ratingsGiven     Rating[]               @relation("RatingsGiven")
  ratingsReceived  Rating[]               @relation("RatingsReceived")
  messages         Message[]
  notifications    Notification[]
  credits          Credit[]
  creditSessionsTaught  CreditSession[]    @relation("CreditTeacher")
  creditSessionsLearned CreditSession[]    @relation("CreditLearner")
  verifications    SkillVerification[]
  reviewsDone      SkillVerification[] @relation("VerificationReviewer")
  quizAttempts     QuizAttempt[]
  certificates     Certificate[]
  reportsMade      Report[] @relation("Reporter")
  reportsReceived  Report[] @relation("ReportedUser")
  tasks            Task[] @relation("TaskPoster")
}

model Skill {
  id      Int    @id @default(autoincrement())
  name    String @unique

  offered UserOfferedSkill[]
  wanted  UserWantedSkill[]
  teaches MatchCycleParticipant[] @relation("Teaches")
  learns  MatchCycleParticipant[] @relation("Learns")
  creditSessions CreditSession[]
  verifications  SkillVerification[]
  quizQuestions  QuizQuestion[]
  quizAttempts   QuizAttempt[]
  certificates   Certificate[]
}

model UserOfferedSkill {
  id      Int        @id @default(autoincrement())
  userId  Int
  skillId Int
  // how proficient the user claims to be at teaching this skill
  level   SkillLevel @default(INTERMEDIATE)
  verificationStatus VerificationStatus @default(NONE)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
}

model UserWantedSkill {
  id      Int        @id @default(autoincrement())
  userId  Int
  skillId Int
  // the level the user is currently at (what they want to reach)
  level   SkillLevel @default(BEGINNER)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
}

model MatchCycle {
  id           Int                     @id @default(autoincrement())
  // proposed -> confirmed -> completed | rejected
  status       String                  @default("proposed")
  completedAt  DateTime?
  createdAt    DateTime                @default(now())

  participants MatchCycleParticipant[]
  ratings      Rating[]
  messages     Message[]
  reports      Report[]
}

model MatchCycleParticipant {
  id             Int        @id @default(autoincrement())
  cycleId        Int
  userId         Int
  teachesSkillId Int
  learnsSkillId  Int
  accepted       Boolean?
  // set when THIS user confirms their side of the exchange is done
  completedAt    DateTime?

  cycle        MatchCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  teachesSkill Skill      @relation("Teaches", fields: [teachesSkillId], references: [id], onDelete: Cascade)
  learnsSkill  Skill      @relation("Learns", fields: [learnsSkillId], references: [id], onDelete: Cascade)

  @@unique([cycleId, userId])
}

// Internal: an edge rejected by a user is removed from the graph
// so the matching engine never proposes the same swap again.
model BlockedEdge {
  id         Int  @id @default(autoincrement())
  fromUserId Int // the user who rejected the incoming edge / or the edge owner
  toUserId   Int // the user offering the skill they no longer want

  fromUser User @relation("BlockedFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("BlockedTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId])
}

// 1-5 star review given by one participant to another, only on completed cycles
model Rating {
  id        Int      @id @default(autoincrement())
  cycleId   Int
  raterId   Int
  rateeId   Int
  score     Int // 1..5
  comment   String?
  createdAt DateTime @default(now())

  cycle MatchCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  rater User      @relation("RatingsGiven", fields: [raterId], references: [id], onDelete: Cascade)
  ratee User      @relation("RatingsReceived", fields: [rateeId], references: [id], onDelete: Cascade)

  @@unique([cycleId, raterId, rateeId])
}

// In-app chat scoped to a confirmed/completed cycle (no WebSockets in MVP)
model Message {
  id        Int      @id @default(autoincrement())
  cycleId   Int
  senderId  Int
  content   String
  createdAt DateTime @default(now())

  cycle  MatchCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  sender User       @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String // match_found | match_accepted | match_rejected | session_completed | new_message | credit_session | verification
  content   String
  link      String? // deep-link path, e.g. /match/12 or /verify
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

// Phase 3 — credit ledger. One row per movement:
//   +1 'teach_now'  — user taught a one-off lesson without being in a cycle
//   -1 'redeem'     — user spent a credit to be taught a skill they want
model Credit {
  id        Int       @id @default(autoincrement())
  userId    Int
  delta     Int // +1 earned, -1 redeemed
  reason    String // teach_now | redeem
  sessionId Int?
  createdAt DateTime  @default(now())

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  session CreditSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Skill verification — proof that a user's claimed proficiency level is real.
// Two methods:
//   QUIZ        — auto-graded question bank; approved/rejected immediately.
//   CERTIFICATE — link to an external certificate + issuer; an admin reviews.
// A user holds at most one verification per (skill, method); retaking a quiz
// overwrites the previous attempt.
model SkillVerification {
  id           Int        @id @default(autoincrement())
  userId       Int
  skillId      Int
  claimedLevel SkillLevel
  method       String // QUIZ | CERTIFICATE
  status       String     @default("pending") // pending | approved | rejected
  score        Int? // quiz: correct answers
  total        Int? // quiz: questions asked
  evidenceUrl  String? // certificate: link to the certificate
  issuer       String? // certificate: who issued it
  note         String? // optional context from the user
  reviewerId   Int?
  reviewedAt   DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user     User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill    Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)
  reviewer User? @relation("VerificationReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@unique([userId, skillId, method])
  @@index([skillId, status])
  @@index([status])
}
// A direct one-sided exchange between an unmatched teacher and a learner,
// used by the credit fallback: teach now, earn a credit — or redeem a
// credit to learn now instead of waiting for a cycle.
model CreditSession {
  id          Int       @id @default(autoincrement())
  teacherId   Int
  learnerId   Int
  skillId     Int?
  createdBy   String // teacher | learner
  status      String   @default("proposed") // proposed -> active -> completed | declined
  type        String   @default("SKILL") // SKILL | TASK
  taskId      Int?
  createdAt   DateTime @default(now())
  completedAt DateTime?
  // Two-sided completion: the teacher's +1 mints only after BOTH sides
  // mark the lesson done (kills single-sided self-minting).
  teacherDoneAt DateTime?
  learnerDoneAt DateTime?

  teacher User  @relation("CreditTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  learner User  @relation("CreditLearner", fields: [learnerId], references: [id], onDelete: Cascade)
  skill   Skill? @relation(fields: [skillId], references: [id], onDelete: SetNull)
  task    Task?  @relation(fields: [taskId], references: [id], onDelete: SetNull)

  credits Credit[]

  @@index([teacherId])
  @@index([learnerId])
  @@index([status])
  @@index([type])
  @@index([taskId])
}

model QuizQuestion {
  id Int @id @default(autoincrement())
  skillId Int
  question String
  options String[]
  correctOptionIndex Int
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)
  @@index([skillId])
}

model QuizAttempt {
  id Int @id @default(autoincrement())
  userId Int
  skillId Int
  score Int
  passed Boolean
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)
  @@index([userId, skillId])
  @@index([skillId])
}

model Certificate {
  id Int @id @default(autoincrement())
  userId Int
  skillId Int
  issuer String
  verificationId String
  status String @default("PENDING")
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)
  @@index([userId, skillId])
  @@index([status])
}

model Report {
  id Int @id @default(autoincrement())
  reporterId Int
  reportedUserId Int
  taskId Int?
  cycleId Int?
  reason String
  status ReportStatus @default(PENDING)
  createdAt DateTime @default(now())
  resolvedAt DateTime?
  reporter User @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser User @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  cycle MatchCycle? @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  @@index([status])
  @@index([reportedUserId])
}

model Task {
  id Int @id @default(autoincrement())
  posterId Int
  title String
  description String
  category String
  creditValue Int
  status TaskStatus @default(OPEN)
  createdAt DateTime @default(now())
  poster User @relation("TaskPoster", fields: [posterId], references: [id], onDelete: Cascade)
  creditSessions CreditSession[]
  reports Report[]
  @@index([status])
  @@index([category])
  @@index([posterId])
}
